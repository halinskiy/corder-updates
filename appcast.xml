        <item>
            <title>0.15.90</title>
            <pubDate>Wed, 21 Oct 2026 20:04:26 +0100</pubDate>
            <sparkle:version>251</sparkle:version>
            <sparkle:shortVersionString>0.15.90</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.2</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description><![CDATA[<ul>
<li>Sessions transcribed from a file, dropped on the window or handed over by an AI assistant, now have a blue dot in the list instead of a green one, so you can tell them apart from your recordings. Hover a session to see where it came from.</li>
</ul>
]]></description>
