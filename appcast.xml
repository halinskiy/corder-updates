        <item>
            <title>0.15.39</title>
            <pubDate>Fri, 10 Jul 2026 21:03:41 +0100</pubDate>
            <sparkle:version>200</sparkle:version>
            <sparkle:shortVersionString>0.15.39</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.2</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description><![CDATA[<ul>
<li>Calls no longer come back with half the transcript translated into English. Each track&#x27;s language is detected from the speech itself and pinned for the whole call, so a quiet or Bluetooth-routed other side stays in the language it was actually spoken in instead of being silently translated.</li>
</ul>
]]></description>
